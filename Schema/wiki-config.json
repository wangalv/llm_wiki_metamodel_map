  "topics_kind": "domain",
  "statuses": [
    "seed",
    "growing",
    "stable",
    "stale"
  ],
  "compiled_fields": [
    "tags",
    "topics",
    "status",
    "created",
    "updated",
    "sources",
    "source_count",
    "aliases"
  ],
  "source_fields": {
    "Title": {
      "type": "string",
      "required": true,
      "description": "The source's own title"
    },
    "Author": {
      "type": "string",
      "required": "recommended",
      "description": "As written in the source; never guessed"
    },
    "Reference": {
      "type": "string",
      "required": true,
      "description": "URL, DOI or bibliographic reference"
    },
    "ContentType": {
      "type": "list",
      "item": "string",
      "required": "recommended",
      "template": [
        "markdown"
      ],
      "description": "What the source contains: markdown, pdf, image, …"
    },
    "Created": {
      "type": "date",
      "required": true,
      "description": "Date the source was added to the vault"
    },
    "Processed": {
      "type": "bool",
      "required": true,
      "description": "true once compiled into Wiki/"
    },
    "tags": {
      "type": "list",
      "item": "string",
      "required": true,
      "template": [
        "source"
      ],
      "description": "Must include source"
    }
  },
  "raw_name_pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
  "placeholders": [
    "YYYY-MM-DD",
    "{{title}}",
    "[[source-stem"
  ],
  "extra_required_dirs": [
    "Schema",
    "_templates",
    "scripts"
  ],
  "rules": [
    {
      "id": "TM1",
      "type": "anchor_required",
      "description": "Every citation points at an exact heading or block, never the whole source — required so a human reviewer can check classification_basis against the source."
    }
  ],
  "generators": [
    {
      "id": "catalogue",
      "type": "catalog_table",
      "kinds": [
        "actor",
        "assumption",
        "business-capability",
        "business-service",
        "capability",
        "constraint",
        "course-of-action",
        "data-entity",
        "function",
        "gap",
        "location",
        "logical-application-component",
        "logical-technology-component",
        "organization-unit",
        "physical-application-component",
        "physical-technology-component",
        "principle",
        "process",
        "requirement",
        "role",
        "technology-service",
        "value-stream",
        "work-package"
      ],
      "columns": [
        "tag",
        "note",
        "status",
        "classification_basis",
        "sources"
      ],
      "output": "Wiki/Generated/Catalogue.md",
      "description": "One row per note of any type, for browsing everything ingested so far."
    },
    {
      "id": "review-queue",
      "type": "catalog_table",
      "kinds": [
        "actor",
        "assumption",
        "business-capability",
        "business-service",
        "capability",
        "constraint",
        "course-of-action",
        "data-entity",
        "function",
        "gap",
        "location",
        "logical-application-component",
        "logical-technology-component",
        "organization-unit",
        "physical-application-component",
        "physical-technology-component",
        "principle",
        "process",
        "requirement",
        "role",
        "technology-service",
        "value-stream",
        "work-package"
      ],
      "where": {
        "status": "seed"
      },
      "columns": [
        "tag",
        "note",
        "classification_basis",
        "sources"
      ],
      "output": "Wiki/Generated/Review Queue.md",
      "description": "Notes not yet confirmed by a human reviewer (status: seed)."
    }
  ]
}